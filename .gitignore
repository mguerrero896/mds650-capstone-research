# Python and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
dist/
build/
*.egg-info/

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem

# Local/raw evidence and data
data/raw/
artifacts/raw/
artifacts/calibration_20d/raw/
artifacts/calibration_20d/option_events/
artifacts/calibration_20d/massive_b1q_cache_v2/
artifacts/calibration_20d/.dedup/
artifacts/calibration_20d/test_writer.parquet
artifacts/pilot/option_events/
artifacts/pilot/invalidated_raw_timestamp_assumption/
artifacts/b1_full_origin/massive_contract_day_cache/
artifacts/api_audit/.common_history_continuity_v5.checkpoint.json
*.duckdb
*.duckdb.wal

# Notebook state
.ipynb_checkpoints/

# Graphify generated graph is versioned; local AST cache and cost counters are not.
graphify-out/cache/
graphify-out/cost.json

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store
.gstack/

# graphify knowledge graph output is hook-regenerated after every commit;
# tracking it kept the tree permanently dirty. It stays on disk, out of git.
graphify-out/

# Claude Code session-local state (worktree registry etc.)
.claude/
artifacts/public_repro_demo/

# Research Program v2 derived panels: large, and derived from licensed provider data.
# Only their JSON summaries and content hashes are versioned (see
# artifacts/rp2_panel_pointers.json); the panels themselves stay local.
artifacts/rp2_block3_target/target_panel.parquet
artifacts/rp2_block4_b0/b0_panel.parquet
artifacts/rp2_block5_surface/b1_surface_panel.parquet
artifacts/rp2_block6_flow/b2_flow_panel.parquet
artifacts/rp2_block11b_forward/tradeable_legs.parquet
artifacts/rp2_block5b_independent/paired_surfaces.parquet

# Scratch pipeline runs write the same derived panels outside the artifacts tree, so the
# rules above do not reach them. Same reason, same treatment: licensed derived data stays
# local and only its digests are versioned.
artifacts_scratch_run/

.worktrees/

# Working files of an in-flight rebuild: the run id being built and its console log.
# The run's own artifacts under artifacts/rp2_v3/<run_id>/ are committed by the gate that
# publishes them, not by the gate that builds the runner.
.run_id
pipeline_run.log

# The panels inside a run directory, for the same reason as the ones under
# artifacts/rp2_block*/: they are large and derived from licensed provider data, and the
# rules above name fixed paths that a run directory's copies do not match. The run's JSON
# summaries, manifests and digests are versioned; the panels stay local.
artifacts/rp2_v3/*/*/*.parquet
artifacts/rp2_v3/*/*.parquet
