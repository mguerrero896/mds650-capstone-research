{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/b1v3-confirmation-base-predictors-v1.schema.json",
  "title": "B1v3 confirmation target-blind base predictor manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_sha256",
    "provider_report_sha256",
    "provider_candidate_plan_sha256",
    "source_confirmation_plan_sha256",
    "target_blind",
    "outcome_read_count",
    "safe_to_read_outcomes",
    "training_session_count",
    "confirmation_session_count",
    "asset_count",
    "assets",
    "origin_count",
    "origin_identity_sha256",
    "fmp",
    "b0",
    "outputs",
    "security",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "PASS_TARGET_BLIND_BASE_PREDICTORS"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "provider_report_sha256": {"$ref": "#/$defs/sha256"},
    "provider_candidate_plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_confirmation_plan_sha256": {"$ref": "#/$defs/sha256"},
    "target_blind": {"const": true},
    "outcome_read_count": {"const": 0},
    "safe_to_read_outcomes": {"const": false},
    "training_session_count": {"const": 60},
    "confirmation_session_count": {"const": 30},
    "asset_count": {"const": 6},
    "assets": {
      "type": "array",
      "prefixItems": [
        {"const": "AAPL"},
        {"const": "AMZN"},
        {"const": "META"},
        {"const": "MSFT"},
        {"const": "NVDA"},
        {"const": "TSLA"}
      ],
      "minItems": 6,
      "maxItems": 6
    },
    "origin_count": {"type": "integer", "minimum": 1},
    "origin_identity_sha256": {"$ref": "#/$defs/sha256"},
    "fmp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_count",
        "session_asset_count",
        "bar_count",
        "availability_primary",
        "availability_sensitivity",
        "provider_semantics_status",
        "records_sha256"
      ],
      "properties": {
        "asset_count": {"const": 8},
        "session_asset_count": {"const": 720},
        "bar_count": {"type": "integer", "minimum": 1},
        "availability_primary": {"const": "timestamp_raw_plus_1_minute"},
        "availability_sensitivity": {"const": "timestamp_raw_plus_2_minutes"},
        "provider_semantics_status": {"const": "CONSERVATIVE_RESEARCH_ASSUMPTION"},
        "records_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "b0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "complete_row_count", "missing_row_count"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 1},
        "complete_row_count": {"type": "integer", "minimum": 0},
        "missing_row_count": {"type": "integer", "minimum": 0}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins", "fmp_bars", "b1_origins", "b0"],
      "properties": {
        "origins": {"$ref": "#/$defs/output"},
        "fmp_bars": {"$ref": "#/$defs/output"},
        "b1_origins": {"$ref": "#/$defs/output"},
        "b0": {"$ref": "#/$defs/output"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_values_emitted", "personal_paths_emitted"],
      "properties": {
        "secret_values_emitted": {"const": false},
        "personal_paths_emitted": {"const": false}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "sha256", "row_count"],
      "properties": {
        "logical_path": {
          "type": "string",
          "pattern": "^MDS650_B1V3_DATA_ROOT/[A-Za-z0-9_.-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
