{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/b1v3-confirmation-common-predictor-v1.schema.json",
  "title": "MDS650 B1v3 Target-Blind Common Predictor Panel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_sha256",
    "target_blind",
    "outcome_read_count",
    "safe_to_read_outcomes",
    "safe_to_evaluate_scientifically",
    "evaluation_blocker",
    "scope",
    "source_bindings",
    "information_sets",
    "completeness",
    "output",
    "security",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "PASS_TARGET_BLIND_COMMON_PREDICTOR_PANEL"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "target_blind": {"const": true},
    "outcome_read_count": {"const": 0},
    "safe_to_read_outcomes": {"const": false},
    "safe_to_evaluate_scientifically": {"const": false},
    "evaluation_blocker": {
      "const": "EVALUATION_TESTS_AND_PREREGISTRATION_PENDING"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_session_count",
        "confirmation_session_count",
        "asset_count",
        "assets",
        "origin_count",
        "origin_identity_sha256"
      ],
      "properties": {
        "training_session_count": {"type": "integer", "minimum": 1},
        "confirmation_session_count": {"type": "integer", "minimum": 0},
        "asset_count": {"const": 6},
        "assets": {
          "const": ["AAPL", "AMZN", "META", "MSFT", "NVDA", "TSLA"]
        },
        "origin_count": {"type": "integer", "minimum": 1},
        "origin_identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_manifest_sha256",
        "b1q_source_manifest_sha256",
        "b1q_source_inventory_sha256",
        "b1v3_feature_manifest_sha256",
        "b2_feature_manifest_sha256"
      ],
      "properties": {
        "base_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "b1q_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "b1q_source_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "b1v3_feature_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "b2_feature_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "information_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B1v3a", "B2"],
      "properties": {
        "B0": {
          "$ref": "#/$defs/b0"
        },
        "B1v3a": {
          "$ref": "#/$defs/b1v3a"
        },
        "B2": {
          "$ref": "#/$defs/b2"
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b0_complete_count",
        "b1v3a_complete_count",
        "b2_complete_count",
        "by_role"
      ],
      "properties": {
        "b0_complete_count": {"type": "integer", "minimum": 0},
        "b1v3a_complete_count": {"type": "integer", "minimum": 0},
        "b2_complete_count": {"type": "integer", "minimum": 0},
        "by_role": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "origin_count",
              "b0_complete_count",
              "b1v3a_complete_count",
              "b2_complete_count"
            ],
            "properties": {
              "role": {"enum": ["development", "confirmation"]},
              "origin_count": {"type": "integer", "minimum": 1},
              "b0_complete_count": {"type": "integer", "minimum": 0},
              "b1v3a_complete_count": {"type": "integer", "minimum": 0},
              "b2_complete_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "sha256", "bytes", "row_count", "columns"],
      "properties": {
        "logical_path": {
          "const": "MDS650_B1V3_DATA_ROOT/predictors/common_predictor_panel.parquet"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret_values_emitted", "personal_paths_emitted"],
      "properties": {
        "secret_values_emitted": {"const": false},
        "personal_paths_emitted": {"const": false}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "b0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_count", "features"],
      "properties": {
        "feature_count": {"const": 12},
        "features": {
          "const": [
            "b0v2_log_spot",
            "b0v2_underlying_return_5m",
            "b0v2_underlying_rv_5m",
            "b0v2_underlying_rv_30m",
            "b0v2_log_dollar_volume_5m",
            "b0v2_spy_return_5m",
            "b0v2_spy_rv_30m",
            "b0v2_qqq_return_5m",
            "b0v2_qqq_rv_30m",
            "b0v2_session_sine",
            "b0v2_session_cosine",
            "b0v2_asset_identity"
          ]
        }
      }
    },
    "b1v3a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_count", "features"],
      "properties": {
        "feature_count": {"const": 15},
        "features": {
          "const": [
            "b0v2_log_spot",
            "b0v2_underlying_return_5m",
            "b0v2_underlying_rv_5m",
            "b0v2_underlying_rv_30m",
            "b0v2_log_dollar_volume_5m",
            "b0v2_spy_return_5m",
            "b0v2_spy_rv_30m",
            "b0v2_qqq_return_5m",
            "b0v2_qqq_rv_30m",
            "b0v2_session_sine",
            "b0v2_session_cosine",
            "b0v2_asset_identity",
            "b1v3_log_atm_variance_30d",
            "b1v3_log_atm_variance_change_5m",
            "b1v3_log_atm_variance_change_30m"
          ]
        }
      }
    },
    "b2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_count", "features"],
      "properties": {
        "feature_count": {"const": 24},
        "features": {
          "const": [
            "b0v2_log_spot",
            "b0v2_underlying_return_5m",
            "b0v2_underlying_rv_5m",
            "b0v2_underlying_rv_30m",
            "b0v2_log_dollar_volume_5m",
            "b0v2_spy_return_5m",
            "b0v2_spy_rv_30m",
            "b0v2_qqq_return_5m",
            "b0v2_qqq_rv_30m",
            "b0v2_session_sine",
            "b0v2_session_cosine",
            "b0v2_asset_identity",
            "b1v3_log_atm_variance_30d",
            "b1v3_log_atm_variance_change_5m",
            "b1v3_log_atm_variance_change_30m",
            "b2_log_trade_count",
            "b2_unique_contract_share",
            "b2_log_mean_trade_premium",
            "b2_log_max_trade_premium",
            "b2_call_put_premium_imbalance_scaled",
            "b2_execution_side_premium_imbalance",
            "b2_repeated_contract_premium_share",
            "b2_strike_concentration",
            "b2_expiry_concentration"
          ]
        }
      }
    }
  }
}
