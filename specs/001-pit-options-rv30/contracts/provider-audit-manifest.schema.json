{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/schemas/provider-audit-manifest-1.1.json",
  "title": "MDS650 provider audit manifest",
  "description": "Sanitized, fail-closed provider audit evidence contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at_utc",
    "research_feature",
    "research_only",
    "secrets_present",
    "secret_values_emitted",
    "provider_results",
    "cross_provider_summary",
    "acceptance"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "run_id": { "type": "string", "format": "uuid" },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "research_feature": { "const": "001-pit-options-rv30" },
    "research_only": { "const": true },
    "secrets_present": { "type": "boolean" },
    "secret_values_emitted": { "const": false },
    "provider_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/providerResult" }
    },
    "cross_provider_summary": { "type": "object" },
    "acceptance": { "type": "object" }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "blocker"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "not_applicable", "unsupported", "unknown"]
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "blocker": { "type": ["string", "null"] }
      }
    },
    "providerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "request_id",
        "provider",
        "component",
        "asset",
        "request_start",
        "request_end",
        "endpoint_fingerprint",
        "record_key",
        "applicability",
        "pit_status",
        "authentication_diagnostic",
        "endpoint_diagnostic",
        "schema_diagnostic",
        "entitlement_diagnostic",
        "pagination",
        "event_iv_fields_present",
        "ordinary_option_state_pit_verified",
        "timestamp_fields",
        "http_status",
        "response_schema_fingerprint",
        "raw_response_hashes",
        "failure_code"
      ],
      "properties": {
        "run_id": { "type": "string", "format": "uuid" },
        "request_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
        "provider": { "type": "string", "enum": ["fmp", "unusual_whales", "massive"] },
        "component": {
          "type": "string",
          "enum": [
            "underlying_1min",
            "structured_earnings",
            "unusual_option_events",
            "ordinary_option_state",
            "contract_trades",
            "contract_quotes",
            "underlying_1min_depth_probe",
            "contract_reference"
          ]
        },
        "asset": {
          "type": ["string", "null"],
          "enum": ["SPY", "QQQ", "AAPL", "MSFT", "NVDA", "TSLA", "AMZN", "META", null]
        },
        "request_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "request_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "endpoint_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16,128}$" },
        "record_key": {
          "type": "string",
          "minLength": 20,
          "pattern": "^[^|]+\\|[^|]+\\|[^|]+\\|[^|]*\\|[^|]+\\|[^|]+\\|[a-f0-9]{16,128}$"
        },
        "applicability": {
          "type": "string",
          "enum": ["applicable", "not_applicable", "unsupported", "invalid_response"]
        },
        "pit_status": {
          "type": "string",
          "enum": ["verified", "not_verified", "not_applicable", "unsupported", "invalid_response"]
        },
        "authentication_diagnostic": { "$ref": "#/$defs/diagnostic" },
        "endpoint_diagnostic": { "$ref": "#/$defs/diagnostic" },
        "schema_diagnostic": { "$ref": "#/$defs/diagnostic" },
        "entitlement_diagnostic": { "$ref": "#/$defs/diagnostic" },
        "event_iv_fields_present": { "type": "boolean" },
        "ordinary_option_state_pit_verified": {
          "type": "string",
          "enum": ["verified", "not_verified", "unsupported", "not_applicable", "invalid_response"]
        },
        "ordinary_option_state_fields_present": { "type": "boolean" },
        "ordinary_option_state_endpoint": { "type": ["string", "null"] },
        "canonical_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "pagination": { "$ref": "#/$defs/diagnostic" },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "rows": { "type": ["integer", "null"], "minimum": 0 },
        "first_complete_date": { "type": ["string", "null"], "format": "date" },
        "last_complete_date": { "type": ["string", "null"], "format": "date" },
        "regular_session_expected_rows": { "type": ["integer", "null"], "minimum": 0 },
        "regular_session_observed_rows": { "type": ["integer", "null"], "minimum": 0 },
        "completeness_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "duplicate_rows": { "type": ["integer", "null"], "minimum": 0 },
        "critical_nulls": { "type": ["integer", "null"], "minimum": 0 },
        "schema_fields": { "type": "array", "items": { "type": "string" } },
        "rows_by_date": { "type": "array", "items": { "type": "object" } },
        "timestamp_format": { "type": ["string", "null"] },
        "timestamp_timezone": { "type": ["string", "null"] },
        "rate_limit_observations": { "type": "object" },
        "safe_extraction_strategy": { "type": ["string", "null"] },
        "response_schema_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{16,128}$"
        },
        "timestamp_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "raw_type", "unit", "semantics", "timezone", "conversion", "origin_relation", "post_availability_possible"],
            "properties": {
              "name": { "type": "string" },
              "raw_type": { "type": "string" },
              "unit": { "type": "string" },
              "semantics": { "type": "string" },
              "timezone": { "type": "string" },
              "conversion": { "type": "string" },
              "origin_relation": { "type": "string" },
              "post_availability_possible": { "type": "boolean" }
            }
          }
        },
        "raw_response_hashes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "requested_symbol": { "type": ["string", "null"] },
        "returned_symbol_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "returned_symbol_matches_requested": { "type": "boolean" },
        "page_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "historical_minimum_observed": {
          "type": ["string", "null"],
          "format": "date"
        },
        "contract_id": {
          "type": ["string", "null"],
          "pattern": "^(O:)?[A-Za-z0-9._-]+$"
        },
        "bid_ask_fields_expected": { "type": "boolean" },
        "calendar_case": { "type": "string" },
        "expected_rows_must_come_from_official_calendar": { "type": "boolean" },
        "calendar_label_assumption": { "type": ["string", "null"] },
        "missing_minute_candidates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_session_dates": {
          "type": "array",
          "items": { "type": "string", "format": "date" }
        },
        "missing_minute_classification": { "type": "string" },
        "expected_entitlement_boundary": { "type": "boolean" },
        "failure_code": { "type": ["string", "null"], "pattern": "^[A-Z0-9_.-]+$" }
      }
    }
  }
}
