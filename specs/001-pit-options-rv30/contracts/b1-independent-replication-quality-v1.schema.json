{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/b1-independent-replication-quality-v1.schema.json",
  "title": "Independent-replication pre-read quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "target_blind", "replication_target_read_count",
    "result_sign_selection", "conditions", "free_gib_at_gate", "source_bindings",
    "security", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "b1-independent-replication-quality-1.0"},
    "status": {"const": "PASS_PRE_READ_REPLICATION_QUALITY"},
    "target_blind": {"const": true},
    "replication_target_read_count": {"const": 0},
    "result_sign_selection": {"const": "PROHIBITED"},
    "conditions": {
      "type": "object", "minProperties": 20,
      "additionalProperties": {"const": true}
    },
    "free_gib_at_gate": {"type": "number", "minimum": 80},
    "source_bindings": {
      "type": "object", "minProperties": 16,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "security": {"$ref": "#/$defs/security"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["secret_values_emitted", "personal_paths_emitted"],
      "properties": {
        "secret_values_emitted": {"const": false},
        "personal_paths_emitted": {"const": false}
      }
    }
  }
}
