{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/target-blind-confirmation-preregistration-v4.schema.json",
  "title": "MDS650 Source-Bound Target-Blind Confirmation Preregistration v4.0",
  "description": "A metadata-only successor method freeze. It does not authorize OOS access, sealed-result reconciliation, acquisition, prospective capture, model fitting, or metric evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scope",
    "purpose",
    "method_freeze_status",
    "target_blind_ready",
    "no_target_or_metric_payload_read",
    "model_fit_performed",
    "claim_boundary",
    "sealed_result_reconciliation",
    "safe_to_reconcile_existing_results",
    "safe_to_open_or_evaluate_oos",
    "safe_to_acquire_new_historical_sample",
    "safe_to_start_prospective_capture",
    "target_definition",
    "information_sets",
    "confirmatory_model",
    "robustness_model",
    "metrics",
    "inference",
    "preflight_workflow",
    "forbidden_runtime_actions",
    "bound_sources",
    "artifact_schema",
    "builder_script_sha256",
    "source_commit",
    "preregistration_sha256"
  ],
  "properties": {
    "schema_version": { "const": "target-blind-confirmation-preregistration-v4.0" },
    "status": { "const": "SEALED_METHOD_FROZEN_TARGET_BLIND_READY_FUTURE_GATES_CLOSED" },
    "scope": { "const": "offline_source_bound_target_blind_method_freeze_only" },
    "purpose": { "const": "freeze_successor_confirmation_method_without_target_or_oos_access" },
    "method_freeze_status": { "const": "FROZEN_TARGET_BLIND_ONLY" },
    "target_blind_ready": { "const": "YES" },
    "no_target_or_metric_payload_read": { "const": true },
    "model_fit_performed": { "const": false },
    "claim_boundary": { "const": "NO_PREDICTIVE_OR_COMPARATIVE_CLAIM" },
    "sealed_result_reconciliation": { "const": "BLOCKED" },
    "safe_to_reconcile_existing_results": { "const": "NO" },
    "safe_to_open_or_evaluate_oos": { "const": "NO" },
    "safe_to_acquire_new_historical_sample": { "const": "NO" },
    "safe_to_start_prospective_capture": { "const": "NO" },
    "target_definition": { "const": "RV30" },
    "information_sets": { "$ref": "#/$defs/informationSets" },
    "confirmatory_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "estimator", "link", "role"],
      "properties": {
        "family": { "const": "Gamma" },
        "estimator": { "const": "GLM" },
        "link": { "const": "log" },
        "role": { "const": "CONFIRMATORY_FIXED" }
      }
    },
    "robustness_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimator", "role", "tuning"],
      "properties": {
        "estimator": { "const": "LightGBM" },
        "role": { "const": "FIXED_ROBUSTNESS" },
        "tuning": { "const": "NONE" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "const": "QLIKE" },
        "secondary": {
          "type": "array",
          "const": ["MAE", "RMSE"]
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resampling", "cluster_unit", "multiplicity", "selection_by_sign"],
      "properties": {
        "resampling": { "const": "PAIRED_DAY_CLUSTER_BOOTSTRAP" },
        "cluster_unit": { "const": "TRADING_DAY" },
        "multiplicity": { "const": "HOLM" },
        "selection_by_sign": { "const": "PROHIBITED" }
      }
    },
    "preflight_workflow": { "$ref": "#/$defs/preflightWorkflow" },
    "forbidden_runtime_actions": {
      "type": "array",
      "const": [
        "OOS_ACCESS",
        "SEALED_RESULT_RECONCILIATION",
        "NEW_HISTORICAL_ACQUISITION",
        "PROSPECTIVE_CAPTURE_START",
        "MODEL_FIT",
        "METRIC_EVALUATION",
        "PROVIDER_NETWORK_CALL"
      ]
    },
    "bound_sources": { "$ref": "#/$defs/boundSources" },
    "artifact_schema": { "$ref": "#/$defs/artifactSchema" },
    "builder_script_sha256": { "$ref": "#/$defs/sha256" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "preregistration_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "informationSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B1a_addition", "B1b_addition", "B1c_addition", "B2_addition"],
      "properties": {
        "B0": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1a_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1b_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1c_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B2_addition": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preflightWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "historical_acquisition_gate",
        "prospective_capture_gate",
        "exact_recheck_command",
        "required_human_inputs",
        "workflow",
        "not_authorization"
      ],
      "properties": {
        "execution_status": { "const": "NOT_EXECUTED" },
        "historical_acquisition_gate": { "const": "GO_AFTER_DATE_LEVEL_PIT_PREFLIGHT" },
        "prospective_capture_gate": { "const": "GO_AFTER_RECEIPT_LOGGER_VALIDATED" },
        "exact_recheck_command": {
          "const": "uv run python scripts/aggregate_pit_reconciliation_gate_v21.py"
        },
        "required_human_inputs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "workflow": { "$ref": "#/$defs/nonEmptyStringArray" },
        "not_authorization": {
          "type": "array",
          "const": ["OOS_ACCESS", "SEALED_RESULT_RECONCILIATION", "MODEL_FIT", "METRIC_EVALUATION"]
        }
      }
    },
    "boundSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v24_predictor_only_manifest",
        "provider_timing_evidence_policy_gate_v1",
        "prior_preregistration_v3"
      ],
      "properties": {
        "v24_predictor_only_manifest": { "$ref": "#/$defs/v24Binding" },
        "provider_timing_evidence_policy_gate_v1": { "$ref": "#/$defs/policyBinding" },
        "prior_preregistration_v3": { "$ref": "#/$defs/preregistrationBinding" }
      }
    },
    "v24Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256", "manifest_sha256", "schema_version", "source_commit"],
      "properties": {
        "logical_path": { "const": "artifacts/target_blind_v24_sourcebound_20260812/target_blind_common_predictor_manifest_v24.json" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "target-blind-common-predictor-manifest-v2.4" },
        "source_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "policyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256", "policy_sha256", "schema_version"],
      "properties": {
        "logical_path": { "const": "artifacts/provider_timing_v22/provider_timing_evidence_policy_gate_v1_20260812.json" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "provider-timing-evidence-policy-gate-v1.0" }
      }
    },
    "preregistrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256", "preregistration_sha256", "schema_version", "source_commit"],
      "properties": {
        "logical_path": { "const": "artifacts/target_blind_v23_sourcebound_20260812/next_confirmation_preregistration_v3.json" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "preregistration_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "target-blind-confirmation-preregistration-v3.0" },
        "source_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "artifactSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256"],
      "properties": {
        "logical_path": {
          "const": "specs/001-pit-options-rv30/contracts/target-blind-confirmation-preregistration-v4.schema.json"
        },
        "file_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
