{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/b1-independent-replication-preregistration-v1.schema.json",
  "title": "MDS650 B1/B2 independent replication preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "target_blind", "safe_to_access_replication_targets",
    "provider_payload_reads_at_freeze", "replication_target_reads", "exposure_ledger_sha256",
    "training_sessions", "replication_sessions", "information_sets", "method", "estimands",
    "mde_policy", "timing_sensitivities", "storage_policy", "result_sign_selection",
    "permitted_terminal_states", "source_hashes", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "b1-independent-replication-preregistration-1.0"},
    "status": {"const": "FROZEN_BEFORE_PROVIDER_PAYLOAD"},
    "target_blind": {"const": true},
    "safe_to_access_replication_targets": {"const": "NO"},
    "provider_payload_reads_at_freeze": {"const": 0},
    "replication_target_reads": {"const": 0},
    "exposure_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "training_sessions": {"$ref": "#/$defs/trainingSessions"},
    "replication_sessions": {"$ref": "#/$defs/replicationSessions"},
    "information_sets": {
      "type": "object", "additionalProperties": false,
      "required": ["B0", "B1v3a", "B2"],
      "properties": {
        "B0": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "B1v3a": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "B2": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "method": {"type": "object"},
    "estimands": {"type": "object"},
    "mde_policy": {"const": "TRAINING_ONLY_DAILY_CLUSTERS_BEFORE_REPLICATION"},
    "timing_sensitivities": {"type": "object"},
    "storage_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["heavy_root", "minimum_projected_free_gib"],
      "properties": {
        "heavy_root": {"const": "MDS650_B1_REPLICATION_DATA_ROOT"},
        "minimum_projected_free_gib": {"const": 80}
      }
    },
    "result_sign_selection": {"const": "PROHIBITED"},
    "permitted_terminal_states": {
      "const": ["REPLICATED_MODEL_INDEPENDENT", "REPLICATED_GAMMA_ONLY", "NOT_REPLICATED", "INVALID_REPLICATION"]
    },
    "source_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["design_sha256", "code_sha256", "uv_lock_sha256"],
      "properties": {
        "design_sha256": {"$ref": "#/$defs/sha256"},
        "code_sha256": {"$ref": "#/$defs/sha256"},
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "trainingSessions": {"type": "array", "minItems": 60, "maxItems": 60, "uniqueItems": true, "items": {"$ref": "#/$defs/date"}},
    "replicationSessions": {"type": "array", "minItems": 30, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/date"}}
  }
}
