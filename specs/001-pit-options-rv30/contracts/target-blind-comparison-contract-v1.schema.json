{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/target-blind-comparison-contract-v1.schema.json",
  "title": "MDS650 Target-Blind Primary Comparison Contract v1.0",
  "description": "Metadata-only preregistration of B1a-versus-B0 and B2-versus-B1a. It does not authorize RV30 access, QLIKE evaluation, model fitting, OOS access, acquisition, or reconciliation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scope",
    "purpose",
    "target_definition",
    "no_target_or_metric_payload_read",
    "model_fit_performed",
    "metric_evaluation_performed",
    "safe_to_reconcile_existing_results",
    "safe_to_open_or_evaluate_oos",
    "safe_to_acquire_new_historical_sample",
    "safe_to_start_prospective_capture",
    "parent_preregistration",
    "model_information_sets",
    "primary_b1_level",
    "primary_benchmark_substitution",
    "b1b_b1c_role",
    "primary_comparisons",
    "inference",
    "selection_controls",
    "forbidden_runtime_actions",
    "artifact_schema",
    "builder_source_sha256",
    "source_commit",
    "comparison_contract_sha256"
  ],
  "properties": {
    "schema_version": { "const": "target-blind-comparison-contract-v1.0" },
    "status": { "const": "SEALED_PRIMARY_COMPARISONS_TARGET_BLIND_NO_EVALUATION" },
    "scope": { "const": "offline_metadata_only_primary_comparison_freeze" },
    "purpose": { "const": "freeze_nested_b0_b1a_b2_comparisons_before_rv30_or_qlike_access" },
    "target_definition": { "const": "RV30" },
    "no_target_or_metric_payload_read": { "const": true },
    "model_fit_performed": { "const": false },
    "metric_evaluation_performed": { "const": false },
    "safe_to_reconcile_existing_results": { "const": "NO" },
    "safe_to_open_or_evaluate_oos": { "const": "NO" },
    "safe_to_acquire_new_historical_sample": { "const": "NO" },
    "safe_to_start_prospective_capture": { "const": "NO" },
    "parent_preregistration": { "$ref": "#/$defs/parentBinding" },
    "model_information_sets": { "$ref": "#/$defs/modelInformationSets" },
    "primary_b1_level": { "const": "B1a" },
    "primary_benchmark_substitution": { "const": "PROHIBITED" },
    "b1b_b1c_role": { "const": "PRE_SPECIFIED_ROBUSTNESS_ONLY" },
    "primary_comparisons": {
      "type": "array",
      "const": [
        {
          "comparison_id": "B1A_VS_B0",
          "benchmark": "B0",
          "challenger": "B1a",
          "estimand": "MEAN_DAILY_QLIKE_B0_MINUS_B1A",
          "positive_direction": "FAVORS_B1A"
        },
        {
          "comparison_id": "B2_VS_B1A",
          "benchmark": "B1a",
          "challenger": "B2",
          "estimand": "MEAN_DAILY_QLIKE_B1A_MINUS_B2",
          "positive_direction": "FAVORS_B2"
        }
      ]
    },
    "inference": { "$ref": "#/$defs/inference" },
    "selection_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_selection_by_rv30_or_qlike",
        "model_selection_by_sign",
        "asset_selection_by_predictive_result",
        "primary_comparison_switching"
      ],
      "properties": {
        "feature_selection_by_rv30_or_qlike": { "const": "PROHIBITED" },
        "model_selection_by_sign": { "const": "PROHIBITED" },
        "asset_selection_by_predictive_result": { "const": "PROHIBITED" },
        "primary_comparison_switching": { "const": "PROHIBITED" }
      }
    },
    "forbidden_runtime_actions": {
      "type": "array",
      "const": [
        "RV30_ACCESS",
        "QLIKE_EVALUATION",
        "MODEL_FIT",
        "OOS_ACCESS",
        "SEALED_RESULT_RECONCILIATION",
        "NEW_HISTORICAL_ACQUISITION",
        "PROSPECTIVE_CAPTURE_START"
      ]
    },
    "artifact_schema": { "$ref": "#/$defs/artifactSchema" },
    "builder_source_sha256": { "$ref": "#/$defs/sha256" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "comparison_contract_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "parentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256", "preregistration_sha256", "schema_version", "source_commit"],
      "properties": {
        "logical_path": {
          "const": "artifacts/target_blind_v24_sourcebound_20260812/next_confirmation_preregistration_v4.json"
        },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "preregistration_sha256": { "$ref": "#/$defs/sha256" },
        "schema_version": { "const": "target-blind-confirmation-preregistration-v4.0" },
        "source_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "modelInformationSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B1a", "B2"],
      "properties": {
        "B0": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1a": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B2": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resampling", "cluster_unit", "multiplicity", "selection_by_sign"],
      "properties": {
        "resampling": { "const": "PAIRED_DAY_CLUSTER_BOOTSTRAP" },
        "cluster_unit": { "const": "TRADING_DAY" },
        "multiplicity": { "const": "HOLM" },
        "selection_by_sign": { "const": "PROHIBITED" }
      }
    },
    "artifactSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_path", "file_sha256"],
      "properties": {
        "logical_path": {
          "const": "specs/001-pit-options-rv30/contracts/target-blind-comparison-contract-v1.schema.json"
        },
        "file_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
