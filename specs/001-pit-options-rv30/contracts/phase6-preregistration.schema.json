{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/phase6-preregistration.schema.json",
  "title": "MDS650 Phase 6 preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approved_on",
    "target",
    "session_manifest_sha256",
    "sessions",
    "session_counts",
    "folds",
    "outcome_assets",
    "market_controls",
    "information_sets",
    "b2v2_feature_names",
    "feature_design_outcome_blind",
    "timing",
    "b2v2_normalization",
    "b1v2_coverage",
    "models",
    "estimands",
    "inference",
    "stability",
    "success_rules",
    "stop_states",
    "outcome_reporting",
    "oos_read_count",
    "provenance",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "phase6-preregistration-1.0"},
    "status": {"enum": ["FROZEN_BEFORE_OOS"]},
    "approved_on": {"type": "string", "format": "date", "const": "2026-08-01"},
    "target": {
      "const": {"name": "RV30", "price_count": 31, "return_count": 30, "horizon_minutes": 30}
    },
    "session_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sessions": {
      "type": "array",
      "minItems": 180,
      "maxItems": 180,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_date", "role"],
        "properties": {
          "session_date": {"$ref": "#/$defs/date"},
          "role": {
            "enum": [
              "warmup",
              "initial_train",
              "oos_fold_1",
              "oos_fold_2",
              "oos_fold_3",
              "oos_fold_4",
              "oos_fold_5"
            ]
          }
        }
      }
    },
    "session_counts": {"const": {"warmup": 20, "initial_train": 60, "oos": 100, "total": 180}},
    "folds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fold", "train_dates", "test_dates", "train_count", "test_count"],
        "properties": {
          "fold": {"type": "integer", "minimum": 1, "maximum": 5},
          "train_dates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/date"}},
          "test_dates": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/date"}
          },
          "train_count": {"enum": [60, 80, 100, 120, 140]},
          "test_count": {"const": 20}
        }
      }
    },
    "outcome_assets": {"const": ["AAPL", "AMZN", "META", "MSFT", "NVDA", "TSLA"]},
    "market_controls": {"const": ["SPY", "QQQ"]},
    "information_sets": {"type": "object"},
    "b2v2_feature_names": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true},
    "feature_design_outcome_blind": {"const": true},
    "timing": {"type": "object"},
    "b2v2_normalization": {"type": "object"},
    "b1v2_coverage": {"type": "object"},
    "models": {"type": "object"},
    "estimands": {"type": "object"},
    "inference": {"type": "object"},
    "stability": {"type": "array", "minItems": 6, "uniqueItems": true},
    "success_rules": {"type": "object"},
    "stop_states": {"type": "array", "minItems": 8, "uniqueItems": true},
    "outcome_reporting": {"const": "RETAIN_ALL_POSITIVE_NEGATIVE_AND_NULL_RESULTS"},
    "oos_read_count": {"const": 0},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "repository_commit",
        "python_version",
        "uv_lock_sha256",
        "design_sha256",
        "spec_sha256",
        "plan_sha256",
        "tasks_sha256",
        "analysis_sha256",
        "phase6_source_sha256",
        "schema_sha256",
        "worktree_dirty"
      ],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"},
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"},
        "design_sha256": {"$ref": "#/$defs/sha256"},
        "spec_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "tasks_sha256": {"$ref": "#/$defs/sha256"},
        "analysis_sha256": {"$ref": "#/$defs/sha256"},
        "phase6_source_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "worktree_dirty": {"type": "boolean"}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date", "pattern": "^202[5-6]-[0-9]{2}-[0-9]{2}$"}
  }
}
