{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/target-blind-confirmation-preregistration-v22.schema.json",
  "title": "MDS650 Target-Blind Confirmation Preregistration v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "purpose",
    "no_target_or_metric_payload_read",
    "model_fit_performed",
    "sealed_result_reconciliation",
    "safe_to_reconcile_existing_results",
    "safe_to_open_or_evaluate_oos",
    "bound_panel",
    "information_sets",
    "fixed_claim_boundary",
    "forbidden_before_successor_method_freeze",
    "required_before_any_oos_access",
    "successor_method_freeze_minimum_contents",
    "source_commit",
    "preregistration_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "target-blind-confirmation-preregistration-v2.0"
    },
    "status": {
      "const": "SEALED_PRE_METHOD_FREEZE_NOT_AUTHORIZED_FOR_OOS"
    },
    "purpose": {
      "const": "bind_corrected_target_blind_inputs_before_successor_method_freeze"
    },
    "no_target_or_metric_payload_read": { "const": true },
    "model_fit_performed": { "const": false },
    "sealed_result_reconciliation": { "const": "BLOCKED" },
    "safe_to_reconcile_existing_results": { "const": "NO" },
    "safe_to_open_or_evaluate_oos": { "const": "NO" },
    "bound_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_sha256",
        "row_count",
        "common_complete_row_count",
        "source_hashes",
        "builder_hashes",
        "timing_rules"
      ],
      "properties": {
        "panel_sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 1 },
        "common_complete_row_count": { "type": "integer", "minimum": 1 },
        "source_hashes": { "type": "object" },
        "builder_hashes": { "type": "object" },
        "timing_rules": { "type": "object" }
      }
    },
    "information_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B1a_addition", "B1b_addition", "B1c_addition", "B2_addition"],
      "properties": {
        "B0": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "B1a_addition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "B1b_addition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "B1c_addition": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "B2_addition": { "type": "array", "minItems": 9, "items": { "type": "string" } }
      }
    },
    "fixed_claim_boundary": { "type": "object" },
    "forbidden_before_successor_method_freeze": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "required_before_any_oos_access": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "successor_method_freeze_minimum_contents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "preregistration_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
