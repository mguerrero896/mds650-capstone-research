{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/target-blind-confirmation-preregistration-v3.schema.json",
  "title": "MDS650 Source-Bound Target-Blind Confirmation Preregistration v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "purpose",
    "no_target_or_metric_payload_read",
    "model_fit_performed",
    "sealed_result_reconciliation",
    "safe_to_reconcile_existing_results",
    "safe_to_open_or_evaluate_oos",
    "bound_panel",
    "method_template_v22_sha256",
    "method_template_v22_preregistration_sha256",
    "method_template_v22_source_commit",
    "information_sets",
    "fixed_claim_boundary",
    "forbidden_before_successor_method_freeze",
    "required_before_any_oos_access",
    "successor_method_freeze_minimum_contents",
    "source_commit",
    "preregistration_sha256"
  ],
  "properties": {
    "schema_version": { "const": "target-blind-confirmation-preregistration-v3.0" },
    "status": { "const": "SEALED_SOURCE_BOUND_PRE_METHOD_FREEZE_NOT_AUTHORIZED_FOR_OOS" },
    "purpose": { "const": "bind_source_bound_target_blind_inputs_before_successor_method_freeze" },
    "no_target_or_metric_payload_read": { "const": true },
    "model_fit_performed": { "const": false },
    "sealed_result_reconciliation": { "const": "BLOCKED" },
    "safe_to_reconcile_existing_results": { "const": "NO" },
    "safe_to_open_or_evaluate_oos": { "const": "NO" },
    "bound_panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_manifest_sha256",
        "panel_sha256",
        "common_complete_sha256",
        "row_count",
        "common_complete_row_count",
        "source_hashes",
        "builder_hashes",
        "timing_rules",
        "input_provenance",
        "panel_builder_source_commit"
      ],
      "properties": {
        "panel_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "panel_sha256": { "$ref": "#/$defs/sha256" },
        "common_complete_sha256": { "$ref": "#/$defs/sha256" },
        "row_count": { "type": "integer", "minimum": 1 },
        "common_complete_row_count": { "type": "integer", "minimum": 1 },
        "source_hashes": { "type": "object", "minProperties": 1 },
        "builder_hashes": { "type": "object", "minProperties": 1 },
        "timing_rules": { "type": "object", "minProperties": 1 },
        "input_provenance": { "type": "object", "minProperties": 1 },
        "panel_builder_source_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "method_template_v22_sha256": { "$ref": "#/$defs/sha256" },
    "method_template_v22_preregistration_sha256": { "$ref": "#/$defs/sha256" },
    "method_template_v22_source_commit": { "$ref": "#/$defs/commit" },
    "information_sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["B0", "B1a_addition", "B1b_addition", "B1c_addition", "B2_addition"],
      "properties": {
        "B0": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1a_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1b_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B1c_addition": { "$ref": "#/$defs/nonEmptyStringArray" },
        "B2_addition": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fixed_claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fmp", "massive", "unusual_whales"],
      "properties": {
        "fmp": { "const": "TIMESTAMP_RAW_PLUS_1_MINUTE_CONSERVATIVE_STUDY_ASSUMPTION" },
        "massive": { "const": "SIP_ASOF_ORIGIN_PRIMARY_WITH_60_300_SECOND_RESELECTION_SENSITIVITIES" },
        "unusual_whales": { "const": "CREATED_AT_OPERATIONAL_AVAILABILITY_PROXY_NOT_PUBLICATION_OR_RECEIPT" }
      }
    },
    "forbidden_before_successor_method_freeze": { "$ref": "#/$defs/nonEmptyStringArray" },
    "required_before_any_oos_access": { "$ref": "#/$defs/nonEmptyStringArray" },
    "successor_method_freeze_minimum_contents": { "$ref": "#/$defs/nonEmptyStringArray" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "preregistration_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
