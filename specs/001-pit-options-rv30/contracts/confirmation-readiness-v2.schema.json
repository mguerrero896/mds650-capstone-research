{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mds650.local/contracts/confirmation-readiness-v2.schema.json",
  "title": "MDS650 Source-Bound Confirmation Readiness v2.0",
  "description": "A target-blind, fail-closed readiness record for preparing a successor method freeze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bound_artifact_integrity",
    "common_subset_validation",
    "model_fit_performed",
    "no_target_or_metric_payload_read",
    "provider_timing_boundary",
    "readiness_sha256",
    "ready_for_successor_method_freeze",
    "required_before_any_oos_access",
    "safe_to_acquire_new_sample",
    "safe_to_open_or_evaluate_oos",
    "safe_to_reconcile_existing_results",
    "schema_version",
    "scope",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "confirmation-readiness-v2.0" },
    "status": {
      "enum": [
        "PASS_SOURCE_BOUND_METHOD_FREEZE_PREPARATION",
        "FAIL_SOURCE_BOUND_READINESS"
      ]
    },
    "scope": { "const": "offline_source_bound_target_blind_readiness_only" },
    "no_target_or_metric_payload_read": { "const": true },
    "model_fit_performed": { "const": false },
    "safe_to_reconcile_existing_results": { "const": "NO" },
    "safe_to_open_or_evaluate_oos": { "const": "NO" },
    "safe_to_acquire_new_sample": { "const": "NO" },
    "ready_for_successor_method_freeze": { "enum": ["YES", "NO"] },
    "bound_artifact_integrity": { "$ref": "#/$defs/integrity" },
    "common_subset_validation": { "$ref": "#/$defs/commonSubset" },
    "provider_timing_boundary": { "$ref": "#/$defs/providerTiming" },
    "required_before_any_oos_access": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "readiness_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha256OrNull": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "failureCodes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability_sidecar_sha256_observed",
        "common_complete_sha256_observed",
        "failure_codes",
        "panel_manifest_sha256_observed",
        "panel_sha256_observed",
        "status"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "failure_codes": { "$ref": "#/$defs/failureCodes" },
        "panel_manifest_sha256_observed": { "$ref": "#/$defs/sha256OrNull" },
        "panel_sha256_observed": { "$ref": "#/$defs/sha256OrNull" },
        "common_complete_sha256_observed": { "$ref": "#/$defs/sha256OrNull" },
        "availability_sidecar_sha256_observed": { "$ref": "#/$defs/sha256OrNull" }
      }
    },
    "commonSubset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_complete_row_count", "failure_codes", "panel_row_count", "status"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "failure_codes": { "$ref": "#/$defs/failureCodes" },
        "panel_row_count": { "type": ["integer", "null"], "minimum": 0 },
        "common_complete_row_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "providerTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_codes", "provider_docs_audit_sha256", "status"],
      "properties": {
        "status": { "enum": ["PASS_LIMITATIONS_RETAINED", "FAIL"] },
        "failure_codes": { "$ref": "#/$defs/failureCodes" },
        "provider_docs_audit_sha256": { "$ref": "#/$defs/sha256OrNull" }
      }
    }
  }
}
